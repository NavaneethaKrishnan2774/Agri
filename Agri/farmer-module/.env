# ============================================
# FARMER MODULE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update values
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmermodule
DB_USER=farmeradmin
DB_PASSWORD=your_secure_password_here_change_this

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis for caching and rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here_change_this
REDIS_DB=0

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_this_must_be_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=1440  # 24 hours
JWT_REFRESH_EXPIRE_DAYS=30

# Data Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here_base64_encoded_required
# Generate with: openssl rand -base64 32

# Password Security
PASSWORD_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_UPPERCASE=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ============================================
# EXTERNAL API KEYS
# ============================================

# SMS Gateway (Msg91/Twilio)
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=FARMER
SMS_AUTH_KEY=your_msg91_auth_key
SMS_ROUTE=4  # 1=Promotional, 4=Transactional

# Weather API
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Market Price API
MARKET_API_KEY=your_data_gov_in_api_key
MARKET_API_URL=https://api.data.gov.in/resource

# Google Maps API (for location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Gateway (Razorpay/Stripe)
PAYMENT_GATEWAY_KEY=your_payment_gateway_key_id
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Email Service (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_DEFAULT_SENDER=noreply@farmermodule.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment
ENVIRONMENT=production  # development, testing, staging, production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=/app/logs/farmer_module.log
LOG_FORMAT=json
LOG_ROTATE_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=10

# File Upload
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf
MAX_IMAGE_SIZE=5242880  # 5MB

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSE_HEADERS=X-Total-Count,Content-Range
CORS_SUPPORTS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET_KEY=your_session_secret_key_change_this
SESSION_TYPE=redis
SESSION_PERMANENT=false
SESSION_USE_SIGNER=true
SESSION_KEY_PREFIX=farmersession:
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# BUSINESS RULES & LIMITS
# ============================================

# Product Limits
MAX_PRODUCTS_PER_FARMER=50
MAX_PRODUCT_QUANTITY=100000  # kg
MIN_PRODUCT_QUANTITY=0.1  # kg
MAX_PRODUCT_PRICE=1000000  # ₹
MIN_PRODUCT_PRICE=1  # ₹

# Order Limits
MAX_ORDER_QUANTITY=10000  # kg per order
MIN_ORDER_AMOUNT=100  # ₹
MAX_ORDER_AMOUNT=1000000  # ₹

# Auction Settings
AUCTION_DURATION_HOURS=24
MIN_BID_INCREMENT_PERCENT=5
MAX_AUCTION_EXTENSIONS=3
AUCTION_EXTENSION_MINUTES=30

# Commission & Fees (No brokerage model)
PLATFORM_COMMISSION_PERCENT=0.0
TRANSACTION_FEE_PERCENT=0.0
PAYMENT_GATEWAY_FEE_PERCENT=2.0
GST_PERCENT=18.0

# Trust Score Parameters
TRUST_SCORE_INITIAL=5.0
TRUST_SCORE_MAX=10.0
TRUST_SCORE_MIN=0.0
TRUST_INCREMENT_PER_SUCCESS=0.1
TRUST_DECREMENT_PER_COMPLAINT=0.5
TRUST_DECREMENT_PER_CANCELLATION=0.3

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# SMS Notifications
SMS_NOTIFICATIONS_ENABLED=true
SMS_OTP_EXPIRE_MINUTES=10
SMS_ORDER_CONFIRMATION=true
SMS_PAYMENT_UPDATE=true
SMS_DELIVERY_UPDATE=true

# Email Notifications
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_ORDER_CONFIRMATION=true
EMAIL_PAYMENT_RECEIPT=true
EMAIL_MARKET_ALERTS=true
EMAIL_NEWSLETTER=true

# Push Notifications
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/app/config/firebase.json

# ============================================
# ALGORITHM SETTINGS
# ============================================

# Buyer Matching Algorithm
MATCHING_RADIUS_KM=50
MATCHING_SCORE_THRESHOLD=0.3
MATCHING_MAX_RESULTS=20
MATCHING_PRICE_WEIGHT=0.25
MATCHING_QUALITY_WEIGHT=0.25
MATCHING_LOCATION_WEIGHT=0.25
MATCHING_REPUTATION_WEIGHT=0.15
MATCHING_TIMING_WEIGHT=0.10

# Fraud Detection
FRAUD_RISK_THRESHOLD_HIGH=75
FRAUD_RISK_THRESHOLD_MEDIUM=50
FRAUD_RISK_THRESHOLD_LOW=20
FRAUD_CHECK_INTERVAL_HOURS=24
MAX_SUSPICIOUS_TRANSACTIONS=10
MAX_PRICE_DEVIATION=3.0

# Community Algorithm
COMMUNITY_CONNECTION_THRESHOLD=0.6
MAX_COMMUNITY_RECOMMENDATIONS=15
COMMUNITY_UPDATE_INTERVAL_HOURS=6

# ============================================
# CACHING CONFIGURATION
# ============================================

# Redis Cache
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300  # 5 minutes
CACHE_KEY_PREFIX=farmer_cache_

# Specific Cache TTLs (seconds)
MARKET_PRICE_CACHE_TTL=3600  # 1 hour
WEATHER_CACHE_TTL=1800  # 30 minutes
PRODUCT_CACHE_TTL=600  # 10 minutes
FARMER_PROFILE_CACHE_TTL=1800  # 30 minutes

# ============================================
# MONITORING & ANALYTICS
# ============================================

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_url
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token
HOTJAR_ID=your_hotjar_id

# ============================================
# DEVELOPMENT & TESTING
# ============================================

# Test Mode
TEST_MODE=false
TEST_PHONE_NUMBER=9876543210
TEST_OTP=123456
TEST_EMAIL=test@farmermodule.com

# Mock Services (for development)
MOCK_SMS=true
MOCK_PAYMENT=true
MOCK_WEATHER=true
MOCK_LOGISTICS=true

# Seed Data
SEED_TEST_DATA=true
SEED_SAMPLE_FARMERS=10
SEED_SAMPLE_PRODUCTS=50
SEED_SAMPLE_BUYERS=5

# ============================================
# ADMINISTRATION
# ============================================

# Admin Credentials (Initial)
ADMIN_EMAIL=admin@farmermodule.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=9999999999

# PgAdmin
PGADMIN_EMAIL=admin@farmermodule.com
PGADMIN_PASSWORD=PgAdmin@123456

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=Grafana@123456

# Portainer
PORTAINER_PASSWORD=Portainer@123456

# ============================================
# BACKUP & MAINTENANCE
# ============================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=@daily
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=6

# Maintenance
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
MAINTENANCE_DAY=Sunday

# Cleanup
OLD_LOGS_RETENTION_DAYS=30
OLD_UPLOADS_RETENTION_DAYS=90
INACTIVE_ACCOUNT_DAYS=365
UNVERIFIED_ACCOUNT_DAYS=7

# ============================================
# SUPPORT & CONTACT
# ============================================

# Support Phone (Button Phone Support)
SUPPORT_PHONE_NUMBER=1800-XXX-XXXX
SUPPORT_PHONE_HOURS=9:00-18:00
SUPPORT_EMAIL=support@farmermodule.com
SUPPORT_WHATSAPP=+91-XXXXXXXXXX

# Emergency Contact
EMERGENCY_PHONE=+91-9999999999
EMERGENCY_EMAIL=emergency@farmermodule.com

# ============================================
# LEGAL & COMPLIANCE
# ============================================

# Terms & Conditions
TERMS_URL=https://farmermodule.com/terms
PRIVACY_POLICY_URL=https://farmermodule.com/privacy
REFUND_POLICY_URL=https://farmermodule.com/refund
SHIPPING_POLICY_URL=https://farmermodule.com/shipping

# Legal Information
COMPANY_NAME=Farmer Module Pvt. Ltd.
COMPANY_ADDRESS=123 Agriculture Street, Farm City, India
COMPANY_GST=29XXXXX1234X1Z5
COMPANY_CIN=U74999XX2023PTC123456